install:
  postgresql: false
  vault: false

fullnameOverride: {{ .Values.connector.fullnameOverride | quote }}
imagePullSecrets:
  - name: {{ .Values.connector.imagePullSecret | quote }}

participant:
  id: {{ printf "did:web:%s" .Values.participant.publicHost | quote }}
  bpnl: {{ .Values.participant.bpn | quote }}
  contextId: {{ printf "did:web:%s" .Values.participant.publicHost | quote }}

dcp:
  trustedIssuers:
    - id: {{ .Values.participant.operatorDid | quote }}
      supportedTypes:
        - MembershipCredential
        - BpnCredential
        - DataExchangeGovernanceCredential
  sts:
    oauth:
      token_url: {{ printf "http://%s:8087/api/sts/token" .Values.identityhub.serviceName | quote }}
      client:
        id: {{ printf "did:web:%s" .Values.participant.publicHost | quote }}
        secret_alias: {{ printf "did:web:%s-sts-client-secret" .Values.participant.publicHost | quote }}
  didService:
    selfRegistration:
      enabled: false
  cache:
    enabled: true
    validity: 86400

controlplane:
  image:
    repository: ghcr.io/wind-x-eu/edc-controlplane-postgresql-hashicorp-vault
    tag: sha-9f724fe
  bdrs:
    server:
      url: {{ .Values.participant.bdrsUrl | quote }}
      environmentVariable: TX_EDC_IAM_IATP_BDRS_SERVER_URL
    cacheValidityEnvironmentVariable: TX_EDC_IAM_IATP_BDRS_CACHE_VALIDITY
    cache_validity_seconds: 600
  policy:
    validation:
      enabled: true
  endpoints:
    management:
      authKeySecret:
        name: {{ .Values.secrets.name | quote }}
        key: {{ .Values.secrets.keys.managementKey | quote }}
  url:
    protocol: {{ printf "https://%s" .Values.participant.publicHost | quote }}
  env:
    EDC_CATALOG_CACHE_EXECUTION_ENABLED: "false"
    EDC_IAM_DID_WEB_USE_HTTPS: "true"
    WEB_HTTP_CATALOG_AUTH_TYPE: tokenbased
  envValueFrom:
    WEB_HTTP_CATALOG_AUTH_KEY:
      secretKeyRef:
        name: {{ .Values.secrets.name | quote }}
        key: {{ .Values.secrets.keys.managementKey | quote }}

dataplane:
  image:
    repository: ghcr.io/wind-x-eu/edc-dataplane-windx
    tag: sha-9f724fe
  participantId: {{ .Values.participant.bpn | quote }}
  endpoints:
    proxy:
      authKeySecret:
        name: {{ .Values.secrets.name | quote }}
        key: {{ .Values.secrets.keys.managementKey | quote }}
  token:
    refresh:
      expiry_seconds: 300
      expiry_tolerance_seconds: 10
      refresh_endpoint: {{ printf "https://%s/api/public/token" .Values.participant.publicHost | quote }}
    signer:
      privatekey_alias: {{ printf "did:web:%s#signing-key-1" .Values.participant.publicHost | quote }}
    verifier:
      publickey_alias: {{ printf "did:web:%s#signing-key-1" .Values.participant.publicHost | quote }}
  url:
    public: {{ printf "https://%s/api/public" .Values.participant.publicHost | quote }}
  env:
    EDC_IAM_DID_WEB_USE_HTTPS: "true"
    TX_EDC_WINDX_MEDIATOR_BASE_URL: {{ .Values.participant.mediatorBaseUrl | quote }}

postgresql:
  jdbcUrl: {{ printf "jdbc:postgresql://%s:%v/%s" .Values.postgresql.host .Values.postgresql.port .Values.postgresql.defaultDatabase | quote }}
  auth:
    username: {{ .Values.postgresql.username | quote }}
    existingSecret: {{ .Values.secrets.name | quote }}
    secretKeys:
      adminPasswordKey: {{ .Values.secrets.keys.postgresPassword | quote }}

vault:
  hashicorp:
    url: {{ .Values.vault.url | quote }}
    tokenSecret:
      name: {{ .Values.secrets.name | quote }}
      key: {{ .Values.secrets.keys.vaultToken | quote }}
    timeout: 30
    healthCheck:
      enabled: true
      standbyOk: true
    paths:
      secret: {{ .Values.vault.secretApiPath | quote }}
      health: {{ .Values.vault.healthApiPath | quote }}
