# =============================================================================
# Wind-X-Teilnehmer im SWMS-Datenraum -- Docker Compose.
#   cp .env.example .env    ->  >>> Felder ausfuellen  ->  docker compose up -d
# =============================================================================

# ---- >>> DEIN Teilnehmer ------------------------------------------------------
# Oeffentlicher Hostname -> Identitaet did:web:<PUBLIC_HOST>. Einmal festlegen.
PUBLIC_HOST=edc.partner.example
# BPN, von SWMS zugeteilt (exakt wie im Operator-Eintrag).
BPN=

# ---- >>> TLS / Proxy ---------------------------------------------------------
# Variante A (Caddy holt Let's Encrypt, Ports 80+443 oeffentlich):
SITE_ADDRESS=edc.partner.example
# Variante B (TLS endet an einem vorgelagerten Proxy, hier nur HTTP):
#SITE_ADDRESS=http://edc.partner.example
HTTP_PORT=80
HTTPS_PORT=443
# Management-API: nur lokal erreichbar (per SSH-Tunnel nutzen).
MGMT_BIND=127.0.0.1:18081

# ---- SWMS-Datenraum (nicht aendern) ------------------------------------------
OPERATOR_DID=did:web:auth-windx.cluster.swms-cloud.com
BDRS_URL=https://auth-windx.cluster.swms-cloud.com/api/directory

# ---- Images ------------------------------------------------------------------
CP_IMAGE=ghcr.io/wind-x-eu/edc-controlplane-postgresql-hashicorp-vault
DP_IMAGE=ghcr.io/wind-x-eu/edc-dataplane-windx
IMAGE_TAG=sha-9f724fe
IH_IMAGE=tractusx/identityhub:0.3.2
MEDIATOR_BASE_URL=http://semanticmediator:3051
LOG_LEVEL=INFO

# ---- Geheimnisse --------------------------------------------------------------
# Nichts einzutragen: der Dienst "secrets" erzeugt VAULT_TOKEN, MGMT_KEY,
# SUPERUSER_KEY und POSTGRES_PASSWORD beim ersten Start im Volume "secrets".
# Management-Key anzeigen:   docker compose exec controlplane sh -c 'cat /secrets/mgmt_key'
