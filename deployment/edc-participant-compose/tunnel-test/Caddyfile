# Wie ../config/Caddyfile, aber mit festem Host-Header: hinter dem Tunnel ist
# nicht garantiert, dass der oeffentliche Name als Host ankommt. Der IdentityHub
# braucht ihn, um das DID-Dokument zu did:web:<PUBLIC_HOST> auszuliefern.
{$SITE_ADDRESS} {
	handle /.well-known/did.json {
		reverse_proxy identityhub:8084 {
			header_up Host {$PUBLIC_HOST}
		}
	}
	handle /api/credentials/* {
		reverse_proxy identityhub:8083 {
			header_up Host {$PUBLIC_HOST}
		}
	}
	handle /api/v1/dsp* {
		reverse_proxy controlplane:8084 {
			header_up Host {$PUBLIC_HOST}
		}
	}
	handle /api/public* {
		reverse_proxy dataplane:8081 {
			header_up Host {$PUBLIC_HOST}
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}
